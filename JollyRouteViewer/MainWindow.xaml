<Window x:Class="JollyRouteViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
        Title="JollyRouteViewer" Width="1500" Height="1000" MinWidth="900" MinHeight="580" Background="#10151C" Foreground="#E5EDF5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263C4C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE6ED"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#19242F" Padding="14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="JollyRouteViewer" FontSize="20" FontWeight="SemiBold" Foreground="#50FF78" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <Button Content="Open GPX / FIT" Click="Open_Click"/>
                <Button Content="Export GPX / FIT" Click="Export_Click"/>
                <Button Content="Reverse route" Click="Reverse_Click"/>
                <Button Content="Fit route" Click="Fit_Click"/>
                <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" IsEnabled="False"/>
                <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" IsEnabled="False"/>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#A9BBC8" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Right" Width="315" Background="#19242F" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ACTIVITY" FontWeight="Bold" Foreground="#50FF78" FontSize="13"/>
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding Type}" Foreground="#A6B8C6" Margin="0,0,0,20"/>
                    <TextBlock Text="DISTANCE" Foreground="#A6B8C6"/>
                    <TextBlock Text="{Binding Distance}" FontSize="29" FontWeight="Bold" Margin="0,3,0,16"/>
                    <TextBlock Text="Elapsed time"/>
                    <TextBlock Text="{Binding Elapsed}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Moving time"/>
                    <TextBlock Text="{Binding Moving}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Average speed"/>
                    <TextBlock Text="{Binding AverageSpeed}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Average pace"/>
                    <TextBlock Text="{Binding AveragePace}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Max recorded speed"/>
                    <TextBlock Text="{Binding MaxSpeed}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Elevation gain / loss"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <TextBlock Text="{Binding ElevationGain}" FontSize="17"/>
                        <TextBlock Text="  /  " FontSize="17"/>
                        <TextBlock Text="{Binding ElevationLoss}" FontSize="17"/>
                    </StackPanel>
                    <CheckBox x:Name="ShowHeartRateCheck" Content="Show heart rate on elevation graph" IsChecked="False" Checked="HeartRateVisibilityChanged" Unchecked="HeartRateVisibilityChanged" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ShowPowerCheck" Content="Show power (watts) on elevation graph" IsChecked="False" Checked="PowerVisibilityChanged" Unchecked="PowerVisibilityChanged" Margin="0,0,0,12"/>
                    <TextBlock Text="Average heart rate"/>
                    <TextBlock Text="{Binding HeartRate}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Average cadence"/>
                    <TextBlock Text="{Binding Cadence}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Average power"/>
                    <TextBlock Text="{Binding Power}" FontSize="17" Margin="0,2,0,10"/>
                    <TextBlock Text="Start"/>
                    <TextBlock Text="{Binding Start}" Margin="0,2,0,20"/>
                    <Separator Background="#415258" Margin="0,0,0,16"/>
                    <TextBlock Text="MAP PROVIDER" FontWeight="Bold" Foreground="#50FF78" Margin="0,0,0,8"/>
                    <ComboBox x:Name="MapProviderCombo" SelectionChanged="MapSettingsChanged" Margin="0,0,0,8">
                        <ComboBoxItem Content="OpenStreetMap (policy applies)" Tag="osm"/>
                        <ComboBoxItem Content="CARTO Light (default)" Tag="cartoLight"/>
                        <ComboBoxItem Content="CARTO Dark" Tag="cartoDark"/>
                        <ComboBoxItem Content="MapTiler Streets" Tag="maptilerStreets"/>
                        <ComboBoxItem Content="MapTiler Outdoor" Tag="maptilerOutdoor"/>
                    </ComboBox>
                    <TextBlock Text="MapTiler API key (for MapTiler maps)" Foreground="#A6B8C6" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="MapKeyBox" Padding="8" Margin="0,0,0,8"/>
                    <Button Content="Apply map / key" Click="ApplyMapKey_Click" Margin="0,0,0,8"/>
                    <TextBlock Text="Settings are saved for next launch. Map providers require internet access and are subject to their usage policies." TextWrapping="Wrap" Foreground="#A6B8C6" Margin="0,0,0,16"/>
                    <Separator Background="#415258" Margin="0,0,0,16"/>
                    <TextBlock Text="SECTION SPEED EDITOR" FontWeight="Bold" Foreground="#50FF78" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SectionInfo" Text="Drag across the elevation graph to select a section." TextWrapping="Wrap" Foreground="#A6B8C6" Margin="0,0,0,10"/>
                    <ComboBox x:Name="TimeMode" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="Save seconds"/>
                        <ComboBoxItem Content="Target average speed (km/h)"/>
                    </ComboBox>
                    <TextBox x:Name="TimeValue" Text="30" Padding="8" Margin="0,0,0,8"/>
                    <Button Content="Apply section speed" Click="ApplyTime_Click" Margin="0,0,0,12"/>
                    <TextBlock Text="Updates timestamps in the selection and shifts later times. Undo is supported; export as GPX or FIT to retain changes." TextWrapping="Wrap" Foreground="#A6B8C6" Margin="0,0,0,16"/>
                    <Separator Background="#415258" Margin="0,0,0,16"/>
                    <TextBlock Text="ROUTE MARKERS" FontWeight="Bold" Foreground="#50FF78"/>
                    <CheckBox x:Name="AllPointsCheck" Content="Show all GPS points" Margin="0,12,0,10" Checked="MarkersChanged" Unchecked="MarkersChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Spacing (km)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="SpacingCombo" Width="90" SelectedIndex="2" SelectionChanged="MarkersChanged">
                            <ComboBoxItem Content="0.25"/>
                            <ComboBoxItem Content="0.5"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="10"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBox Text="{Binding MarkerCount, Mode=OneWay}" IsReadOnly="True" />
                    <TextBlock Text="Drag a marker to smoothly reshape the route between neighbouring markers. Undo/redo edits, then export GPX or FIT to save." TextWrapping="Wrap" Foreground="#A6B8C6" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <wv2:WebView2 x:Name="MapView"/>
    </DockPanel>
</Window>
